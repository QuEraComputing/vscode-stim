{
  "name": "vscode-stim",
  "displayName": "Stim",
  "description": "Syntax highlighting and circuit visualization for .stim and .dem files",
  "version": "0.1.0",
  "publisher": "QuEraComputing",
  "author": "QuEra Computing Inc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuEraComputing/vscode-stim.git"
  },
  "homepage": "https://github.com/QuEraComputing/vscode-stim#readme",
  "bugs": {
    "url": "https://github.com/QuEraComputing/vscode-stim/issues"
  },
  "icon": "media/vscode-stim.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "stim",
    "quantum",
    "quantum error correction",
    "circuit",
    "visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:stim",
    "onLanguage:dem"
  ],
  "contributes": {
    "languages": [
      {
        "id": "stim",
        "aliases": [
          "Stim",
          "stim"
        ],
        "extensions": [
          ".stim"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "dem",
        "aliases": [
          "Stim DEM",
          "dem"
        ],
        "extensions": [
          ".dem"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "stim",
        "scopeName": "source.stim",
        "path": "./syntaxes/stim.tmLanguage.json"
      },
      {
        "language": "dem",
        "scopeName": "source.dem",
        "path": "./syntaxes/dem.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "stim.visualize",
        "title": "Stim: Visualize Circuit",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "stim.visualize",
          "when": "resourceLangId == stim || resourceLangId == dem",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build:wasm": "bash wasm/build-wasm.sh",
    "test:wasm": "node wasm/harness.mjs",
    "test:grammar": "vscode-tmgrammar-test \"test/grammar/*.stim\"",
    "build:test": "tsc src/stimEngine.ts src/tsim.ts --outDir dist-test --module nodenext --target ES2021 --moduleResolution nodenext --skipLibCheck",
    "test:engine": "npm run build:test && node --test test/engine.test.mjs test/tsim.test.mjs",
    "vscode:prepublish": "node esbuild.js --production"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.15"
  }
}
